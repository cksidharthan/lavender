package pages

import (
	"strconv"

	"github.com/cksidharthan/lavender/pkg/ui/components"
)

const cardClass = "rounded-2xl border border-slate-200 bg-white shadow-xs"

// The settings page has tabs, each its own address, so a refresh and the back button keep the place. The tab bar and
// the title are the same for all of them.

// settingsTab is a tab of the settings.
type settingsTab struct {
	Name string
	Href string
}

var settingsTabs = []settingsTab{
	{Name: "Account", Href: "/settings"},
	{Name: "Feeds", Href: "/settings/feeds"},
	{Name: "Data", Href: "/settings/data"},
}

const (
	TabAccount = "/settings"
	TabFeeds   = "/settings/feeds"
	TabData    = "/settings/data"
)

// SettingsAccount is the tab of the profile, the password and two-factor authentication.
templ SettingsAccount(p SettingsPage) {
	@settingsLayout(TabAccount) {
		<section class={ cardClass + " mt-6 p-5" } aria-labelledby="account-title">
			<h2 id="account-title" class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Account</h2>
			<div class="mt-4 flex flex-col gap-5 sm:flex-row">
				<span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-brand to-indigo-400 text-xl font-semibold text-white" aria-hidden="true">{ p.Initials }</span>
				<form hx-post="/api/v1/account/profile" hx-swap="none" hx-disabled-elt="find button[type=submit]" class="grid flex-1 gap-4 sm:grid-cols-2">
					<div>
						<label for="profile-name" class="mb-1.5 block font-medium text-slate-700 sm:text-sm">Name</label>
						<input id="profile-name" name="name" type="text" autocomplete="name" maxlength="255" value={ p.Name } class={ components.InputClass() }/>
					</div>
					<div>
						<label for="profile-email" class="mb-1.5 block font-medium text-slate-700 sm:text-sm">Email</label>
						<input id="profile-email" name="email" type="email" autocomplete="email" required value={ p.Email } class={ components.InputClass() }/>
					</div>
					<div>
						<label for="profile-password" class="mb-1.5 block font-medium text-slate-700 sm:text-sm">Current password</label>
						<input id="profile-password" name="current_password" type="password" autocomplete="current-password" placeholder="Only to change the email" class={ components.InputClass() }/>
					</div>
					<div class="flex items-end sm:justify-end">
						@components.Button(components.ButtonProps{Type: "submit"}) {
							Save profile
						}
					</div>
				</form>
			</div>
		</section>
		<section class={ cardClass + " mt-4 p-5" } aria-labelledby="password-title">
			<h2 id="password-title" class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Password</h2>
			<form hx-post="/api/v1/account/password" hx-swap="none" hx-disabled-elt="find button[type=submit]" class="mt-4">
				<div class="grid gap-x-4 sm:grid-cols-3">
					@components.PasswordField(components.FieldProps{ID: "current-password", Name: "current_password", Label: "Current password", Placeholder: "Your current password", Autocomplete: "current-password", Required: true})
					@components.PasswordField(components.FieldProps{ID: "new-password", Name: "new_password", Label: "New password", Placeholder: "At least 8 characters", Autocomplete: "new-password", Required: true})
					@components.PasswordField(components.FieldProps{ID: "confirm-password", Name: "confirm_password", Label: "Confirm the new password", Placeholder: "The new password again", Autocomplete: "new-password", Required: true})
				</div>
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<p class="text-sm text-slate-500">Changing the password signs you out of your other devices.</p>
					@components.Button(components.ButtonProps{Type: "submit"}) {
						Change password
					}
				</div>
			</form>
		</section>
		@TwoFactor(p.TwoFactor)
	}
}

// SettingsFeeds is the tab of the refresh interval, the feeds and OPML.
templ SettingsFeeds(p SettingsPage) {
	@settingsLayout(TabFeeds) {
		<section class={ cardClass + " mt-6 p-5" } aria-labelledby="refresh-title">
			<h2 id="refresh-title" class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Refresh</h2>
			<form hx-post="/api/v1/account/settings" hx-swap="none" hx-disabled-elt="find button[type=submit]" class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-end">
				<div class="flex-1">
					<label for="default-refresh" class="mb-1.5 block font-medium text-slate-700 sm:text-sm">Default feed refresh interval (minutes)</label>
					<input id="default-refresh" name="default_refresh_minutes" type="number" inputmode="numeric" min="5" max="1440" step="1" value={ p.DefaultRefresh } placeholder={ strconv.Itoa(p.ServerRefresh) } class={ components.InputClass() }/>
				</div>
				@components.Button(components.ButtonProps{Type: "submit"}) {
					Save
				}
			</form>
			<p class="mt-3 text-sm text-slate-500">
				Feeds without an interval of their own are refreshed every
				<strong class="font-semibold text-slate-700">{ strconv.Itoa(p.EffectiveRefresh) } minutes</strong>.
				The default of this server is { strconv.Itoa(p.ServerRefresh) } minutes, leave the field empty to use it. A feed can have its own interval in its settings.
			</p>
		</section>
		<section class="mt-8" aria-labelledby="feeds-title">
			<div class="flex items-baseline justify-between">
				<h2 id="feeds-title" class="text-sm font-semibold text-slate-900">Feeds</h2>
				<p class="text-xs text-slate-500">{ strconv.Itoa(len(p.Feeds)) } in total</p>
			</div>
			<div class={ cardClass + " mt-3 overflow-hidden" }>
				if len(p.Feeds) == 0 {
					<p class="p-6 text-center text-sm text-slate-500">You do not follow any feeds yet. Add one with the + in the sidebar.</p>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full min-w-xl text-left text-sm">
							<thead class="border-b border-slate-100 text-xs font-medium text-slate-500">
								<tr>
									<th scope="col" class="px-4 py-3 font-medium">Feed</th>
									<th scope="col" class="px-4 py-3 font-medium">Articles</th>
									<th scope="col" class="hidden px-4 py-3 font-medium md:table-cell">With a picture</th>
									<th scope="col" class="hidden px-4 py-3 font-medium sm:table-cell">Refreshes every</th>
									<th scope="col" class="hidden px-4 py-3 font-medium sm:table-cell">Last refreshed</th>
									<th scope="col" class="px-4 py-3 font-medium">Status</th>
									<th scope="col" class="w-12 px-2 py-3"><span class="sr-only">Actions</span></th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								for _, f := range p.Feeds {
									<tr class="transition hover:bg-slate-50">
										<td class="px-4 py-3">
											<div class="flex items-center gap-3">
												@components.FeedIcon(f.IconURL, f.Title, "size-6")
												<div class="min-w-0">
													<a href={ templ.SafeURL("/feeds/" + f.ID) } { components.ContentLink("/feeds/" + f.ID)... } class="block max-w-64 truncate font-medium text-slate-900 hover:text-brand">{ f.Title }</a>
													<p class="max-w-64 truncate text-xs text-slate-500" title={ f.URL }>{ f.URL }</p>
													if f.Folder != "" {
														<p class="truncate text-xs text-slate-500">{ f.Folder }</p>
													}
												</div>
											</div>
										</td>
										<td class="px-4 py-3">
											<span class="text-slate-900 tabular-nums">{ f.Articles }</span>
										</td>
										<td class="hidden px-4 py-3 text-slate-600 tabular-nums md:table-cell">{ f.Images }</td>
										<td class="hidden px-4 py-3 text-slate-600 sm:table-cell">{ f.Refresh }</td>
										<td class="hidden px-4 py-3 text-slate-600 sm:table-cell">{ f.LastFetched }</td>
										<td class="px-4 py-3">
											<div class="flex flex-wrap gap-1">
												for _, b := range f.Badges {
													<span class={ badgeClass(b.Tone) } title={ b.Title }>{ b.Label }</span>
												}
											</div>
										</td>
										<td class="px-2 py-3 text-right">
											@feedRowMenu(f)
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</section>
		<section class="mt-8" aria-labelledby="opml-title">
			<h2 id="opml-title" class="text-sm font-semibold text-slate-900">OPML</h2>
			<p class="mt-1 text-sm text-slate-500">The list of your feeds in the file that feed readers share, to move to Lavender or away from it. Only the feeds and their folders are in it, not their articles.</p>
			<div class={ cardClass + " mt-3 grid divide-y divide-slate-100 md:grid-cols-2 md:divide-x md:divide-y-0" }>
				<div class="flex flex-col p-5">
					<h3 class="font-semibold text-slate-900">Export feeds</h3>
					<p class="mt-2 flex-1 text-sm text-slate-500">Download your { strconv.Itoa(len(p.Feeds)) } feeds as an OPML file, each in its folder.</p>
					<a href="/api/v1/account/opml/export" download class={ components.LinkButtonClass(components.ButtonProps{Variant: components.ButtonSecondary}) + " mt-5 self-start" }>
						Download OPML
					</a>
				</div>
				<div class="flex flex-col p-5">
					<h3 class="font-semibold text-slate-900">Import feeds</h3>
					<p class="mt-2 text-sm text-slate-500">Add the feeds of an OPML file from another reader. The folders are created, and a feed that you follow already is skipped. Their articles are fetched in the background.</p>
					<form hx-post="/api/v1/account/opml/import" hx-encoding="multipart/form-data" hx-swap="none" hx-disabled-elt="find button[type=submit]" class="mt-5 flex flex-1 flex-col justify-end gap-3">
						<input type="file" name="file" accept=".opml,.xml,text/xml,text/x-opml,application/xml" required aria-label="OPML file" class="block w-full cursor-pointer rounded-lg border border-slate-200 bg-white text-sm text-slate-600 shadow-xs file:mr-3 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-4 file:py-2.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200"/>
						@components.Button(components.ButtonProps{Type: "submit", Variant: components.ButtonSecondary}) {
							Import OPML
						}
					</form>
				</div>
			</div>
		</section>
	}
}

// SettingsData is the tab of what is stored, and the backup.
templ SettingsData(p SettingsPage) {
	@settingsLayout(TabData) {
		<section class="mt-6" aria-labelledby="overview-title">
			<h2 id="overview-title" class="text-sm font-semibold text-slate-900">Overview</h2>
			<dl class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
				for _, t := range p.Tiles {
					<div class={ cardClass + " p-4" }>
						<dt class="text-xs font-medium text-slate-500">{ t.Label }</dt>
						<dd class="mt-1 text-2xl font-semibold tracking-tight text-slate-900 tabular-nums">{ t.Value }</dd>
						<dd class="mt-0.5 truncate text-xs text-slate-400">{ t.Hint }</dd>
					</div>
				}
			</dl>
		</section>
		<section class="mt-8" aria-labelledby="backup-title">
			<h2 id="backup-title" class="text-sm font-semibold text-slate-900">Backup</h2>
			<div class={ cardClass + " mt-3 grid divide-y divide-slate-100 md:grid-cols-2 md:divide-x md:divide-y-0" }>
				<div class="flex flex-col p-5">
					<div class="flex items-center gap-3">
						<span class="flex size-9 items-center justify-center rounded-lg bg-brand/10 text-brand" aria-hidden="true">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
						</span>
						<h3 class="font-semibold text-slate-900">Export</h3>
					</div>
					<p class="mt-3 flex-1 text-sm text-slate-500">
						Download everything of your account as one zip file: the folders and feeds with their settings, all the articles, your favourites and what you saved for later, the default refresh interval and the icons. Import it on a fresh Lavender to continue where you were.
					</p>
					<a href="/api/v1/account/export" download class={ components.LinkButtonClass(components.ButtonProps{}) + " mt-5 self-start" }>
						Download backup
					</a>
				</div>
				<div class="flex flex-col p-5">
					<div class="flex items-center gap-3">
						<span class="flex size-9 items-center justify-center rounded-lg bg-brand/10 text-brand" aria-hidden="true">
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3M7 8l5-5 5 5M5 21h14"></path></svg>
						</span>
						<h3 class="font-semibold text-slate-900">Import</h3>
					</div>
					<p class="mt-3 text-sm text-slate-500">
						Choose a backup file. It is added to your account: what is there already stays, and a folder, feed or article that is in both is not added again. Importing the same file twice changes nothing.
					</p>
					<form hx-post="/api/v1/account/import" hx-encoding="multipart/form-data" hx-swap="none" hx-disabled-elt="find button[type=submit]" class="mt-5 flex flex-1 flex-col justify-end gap-3">
						<input type="file" name="file" accept=".zip,application/zip" required aria-label="Backup file" class="block w-full cursor-pointer rounded-lg border border-slate-200 bg-white text-sm text-slate-600 shadow-xs file:mr-3 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-4 file:py-2.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200"/>
						@components.Button(components.ButtonProps{Type: "submit", Variant: components.ButtonSecondary}) {
							Import backup
						}
					</form>
				</div>
			</div>
		</section>
	}
}

templ settingsLayout(active string) {
	<div class="mx-auto max-w-5xl pb-10">
		<header>
			<h1 class={ components.TitleClass }>Settings</h1>
			<p class="mt-1 text-sm text-slate-500">Your account, your feeds, and what is stored for them.</p>
		</header>
		<nav aria-label="Sections of the settings" class="mt-5 flex gap-1 overflow-x-auto border-b border-slate-200">
			for _, tab := range settingsTabs {
				<a
					href={ templ.SafeURL(tab.Href) }
					{ components.ContentLink(tab.Href)... }
					data-nav
					data-nav-exact
					aria-current={ currentPage(tab.Href == active) }
					class="-mb-px shrink-0 border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-500 transition hover:border-slate-300 hover:text-slate-800 aria-[current=page]:border-brand aria-[current=page]:text-brand"
				>{ tab.Name }</a>
			}
		</nav>
		{ children... }
	</div>
}

// feedRowMenu are the actions of a feed in the table. Its dialogs are the ones of the sidebar, they are opened by the
// script of the App layout, and the menu is placed below its button.
templ feedRowMenu(f FeedRow) {
	<button
		type="button"
		popovertarget={ "row-menu-" + f.ID }
		aria-label={ "Actions for " + f.Title }
		aria-haspopup="menu"
		class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
	>
		<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="19" cy="12" r="1.6"></circle></svg>
	</button>
	<div id={ "row-menu-" + f.ID } popover data-menu data-menu-below role="menu" class="fixed m-0 w-52 rounded-lg border border-slate-200 bg-white p-1 text-left shadow-lg shadow-slate-900/10">
		<button type="button" role="menuitem" class={ components.MenuItemClass } hx-post="/api/v1/feeds/refresh" hx-vals={ components.IDVals(f.ID) } hx-on::after-request="reloadFeedPage()" hx-swap="none">
			<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"></path></svg>
			Refresh feed
		</button>
		<button type="button" role="menuitem" class={ components.MenuItemClass } data-open-modal="rename-feed-modal" data-id={ f.ID } data-name={ f.Title }>
			<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
			Rename feed
		</button>
		<button type="button" role="menuitem" class={ components.MenuItemClass } data-open-modal="edit-feed-url-modal" data-settings={ components.FeedURLJSON(components.Feed{ID: f.ID, URL: f.URL}) }>
			<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
			Edit URL
		</button>
		<hr class="my-1 border-slate-100"/>
		<button type="button" role="menuitem" class={ components.MenuItemDanger } data-open-modal="clear-feed-modal" data-id={ f.ID } data-name={ f.Title }>
			<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"></path></svg>
			Delete cached posts
		</button>
		<button type="button" role="menuitem" class={ components.MenuItemDanger } data-open-modal="delete-feed-modal" data-id={ f.ID } data-name={ f.Title }>
			<svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v5M14 11v5"></path></svg>
			Delete feed
		</button>
	</div>
}
