package layouts

import "github.com/cksidharthan/lavender/pkg/ui/components"

// App is the shell for the signed in pages: a sidebar with the feeds on the left and the page content on the right.
templ App(title string, sidebar components.SidebarProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="referrer" content="no-referrer"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ title } · Lavender</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
			<link rel="manifest" href="/static/manifest.webmanifest"/>
			<meta name="theme-color" content="#ffffff"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="Lavender"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<link rel="stylesheet" href="/static/app.css"/>
			@components.ThemeScript()
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class="h-dvh overflow-hidden bg-slate-50 font-sans text-slate-950 antialiased">
			<div class="flex h-dvh">
				@components.Sidebar(sidebar)
				<div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-black/40 data-[open]:block md:hidden" onclick="toggleSidebar(false)"></div>
				<div class="flex min-w-0 flex-1 flex-col">
					<header class="grid min-h-16 grid-cols-[5rem_1fr_5rem] items-center border-b border-slate-200 bg-surface px-3 pt-[calc(env(safe-area-inset-top)+1.5rem)] pb-2 md:hidden">
						<button type="button" aria-label="Open menu" onclick="toggleSidebar(true)" class="flex size-10 cursor-pointer items-center justify-center rounded-full text-slate-700 transition active:bg-slate-100">
							<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h16"></path></svg>
						</button>
						<a href="/" { components.ContentLink("/")... } class="flex items-center justify-center gap-2 text-lg font-bold tracking-tight text-indigo-950">
							@components.LogoMark("size-7 text-brand")
							<span>Lavender</span>
						</a>
						<div class="flex items-center justify-end">
							<a href="/search" { components.ContentLink("/search")... } aria-label="Search" class="flex size-10 cursor-pointer items-center justify-center rounded-full text-slate-700 transition active:bg-slate-100">
								<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
							</a>
							<button
								type="button"
								aria-label="Refresh all feeds"
								hx-post="/api/v1/feeds/refresh-all"
								hx-swap="none"
								hx-disabled-elt="this"
								hx-on::after-request="reloadFeedPage()"
								class="flex size-10 cursor-pointer items-center justify-center rounded-full text-slate-700 transition active:bg-slate-100 disabled:opacity-50"
							>
								@components.IconRefresh()
							</button>
						</div>
					</header>
					<main id="content" class="flex-1 overflow-y-auto px-4 pt-5 pb-[max(1rem,env(safe-area-inset-bottom))] sm:p-6">
						{ children... }
					</main>
				</div>
			</div>
			@components.ConfirmModal(components.ConfirmModalProps{
				ID:           "logout-modal",
				Title:        "Log out?",
				Message:      "You will need to sign in again to access your account.",
				ConfirmLabel: "Logout",
				CancelLabel:  "Cancel",
				Danger:       true,
				ConfirmAttrs: templ.Attributes{"hx-post": "/logout"},
			})
			<dialog
				id="article-panel"
				aria-label="Article"
				onclick="if (event.target === this) this.close()"
				class="m-0 mt-auto ml-auto h-[calc(100dvh-env(safe-area-inset-top)-0.75rem)] max-h-none w-full max-w-none translate-y-full overflow-y-auto overscroll-contain rounded-t-2xl border-slate-200 bg-surface p-0 text-slate-950 shadow-2xl transition-[translate,display,overlay] duration-200 transition-discrete backdrop:bg-black/40 open:translate-y-0 starting:open:translate-y-full sm:mt-0 sm:h-dvh sm:w-[72vw] sm:max-w-[90rem] sm:translate-x-full sm:translate-y-0 sm:rounded-none sm:border-l sm:open:translate-x-0 sm:starting:open:translate-x-full"
			>
				<div class="mx-auto mt-2 h-1.5 w-10 rounded-full bg-slate-300 sm:hidden" aria-hidden="true"></div>
				<button type="button" aria-label="Close" onclick="this.closest('dialog').close()" class="sticky top-3 left-3 z-10 -mb-12 ml-3 flex size-9 cursor-pointer items-center justify-center rounded-full bg-surface text-slate-600 shadow-md ring-1 ring-slate-200 transition hover:bg-slate-50 hover:text-slate-900">
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
				</button>
				<div id="article-panel-body"></div>
			</dialog>
			@components.ToastContainer()
			<script>
				// open the article panel with a placeholder, the article is swapped in when it is loaded
				function openArticlePanel() {
					var panel = document.getElementById('article-panel');
					document.getElementById('article-panel-body').innerHTML = '<p class="px-6 pt-16 text-sm text-slate-500">Loading…</p>';
					panel.scrollTop = 0;
					if (!panel.open) panel.showModal();
				}
				// show the new articles after a refresh, when the home page or a feed is open
				// remember where the user is in an episode on the server, so it goes on from there on any device
				(function () {
					var saved = 0;
					function isPlayer(a) { return a instanceof HTMLAudioElement && a.dataset.articleId; }
					function send(a, seconds) {
						saved = seconds;
						fetch('/api/v1/articles/progress', {
							method: 'POST',
							credentials: 'same-origin',
							keepalive: true,
							headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
							body: new URLSearchParams({ id: a.dataset.articleId, seconds: String(seconds) })
						}).catch(function () {});
					}
					document.addEventListener('loadedmetadata', function (e) {
						var a = e.target;
						if (!isPlayer(a)) return;
						var t = parseFloat(a.dataset.start);
						saved = t || 0;
						if (t > 0 && t < a.duration - 5) a.currentTime = t;
					}, true);
					document.addEventListener('timeupdate', function (e) {
						var a = e.target;
						// not on every tick, once in a while is enough
						if (isPlayer(a) && !a.paused && Math.abs(a.currentTime - saved) >= 10) send(a, Math.floor(a.currentTime));
					}, true);
					document.addEventListener('pause', function (e) {
						var a = e.target;
						if (isPlayer(a) && !a.ended && Math.abs(a.currentTime - saved) >= 1) send(a, Math.floor(a.currentTime));
					}, true);
					document.addEventListener('ended', function (e) {
						if (isPlayer(e.target)) send(e.target, 0);
					}, true);
				})();
				function reloadFeedPage() {
					if (/^\/(feeds\/[^/]+|today|favourites|read-later|settings(\/(appearance|feeds|data))?)?$/.test(location.pathname)) {
						htmx.ajax('GET', location.pathname, { target: '#content', swap: 'innerHTML' });
					}
				}
				document.addEventListener('reload-feed-page', reloadFeedPage);
				function toggleSidebar(open) {
					document.getElementById('sidebar').toggleAttribute('data-open', open);
					document.getElementById('sidebar-backdrop').toggleAttribute('data-open', open);
				}
				// a long swipe to the right closes the article, unless it starts in something that scrolls sideways
				(function () {
					var panel = document.getElementById('article-panel');
					var start = null;
					function scrollsSideways(el) {
						for (; el && el !== panel; el = el.parentElement) {
							if (el.scrollWidth > el.clientWidth && /auto|scroll/.test(getComputedStyle(el).overflowX)) return true;
						}
						return false;
					}
					panel.addEventListener('touchstart', function (e) {
						var t = e.touches[0];
						start = e.touches.length === 1 && !scrollsSideways(e.target) ? { x: t.clientX, y: t.clientY } : null;
					}, { passive: true });
					panel.addEventListener('touchend', function (e) {
						if (!start) return;
						var t = e.changedTouches[0];
						var dx = t.clientX - start.x, dy = t.clientY - start.y;
						if (dx > 100 && dx > Math.abs(dy) * 2) panel.close();
						start = null;
					}, { passive: true });
				})();
				// on small screens the article is a sheet: pull it down from the top to close it
				(function () {
					var panel = document.getElementById('article-panel');
					var drag = null;
					panel.addEventListener('touchstart', function (e) {
						drag = window.innerWidth < 640 && e.touches.length === 1 && panel.scrollTop <= 0 && !e.target.closest('audio') ? { y: e.touches[0].clientY, dy: 0, t: Date.now(), on: false } : null;
					}, { passive: true });
					panel.addEventListener('touchmove', function (e) {
						if (!drag) return;
						var dy = e.touches[0].clientY - drag.y;
						if (!drag.on && (dy <= 0 || panel.scrollTop > 0)) { if (dy < 0) drag = null; return; }
						drag.on = true;
						drag.dy = Math.max(dy, 0);
						panel.style.transition = 'none';
						panel.style.translate = '0 ' + drag.dy + 'px';
						e.preventDefault();
					}, { passive: false });
					function release() {
						if (!drag || !drag.on) { drag = null; return; }
						var fast = drag.dy / Math.max(Date.now() - drag.t, 1) > 0.5;
						var close = drag.dy > 120 || (fast && drag.dy > 40);
						drag = null;
						panel.style.transition = '';
						if (!close) { panel.style.translate = ''; return; }
						panel.style.translate = '0 100%';
						setTimeout(function () { panel.close(); panel.style.translate = ''; }, 200);
					}
					panel.addEventListener('touchend', release);
					panel.addEventListener('touchcancel', release);
				})();
				// selects with data-select get a dropdown in the style of the app. The select stays, hidden, it holds the value
				// that is submitted and that the other scripts set. The dropdown follows it, _sync() after the value was set.
				function enhanceSelect(sel) {
					if (sel._sync) return;
					var base = sel.id || 'select-' + Math.random().toString(36).slice(2);
					var btn = document.createElement('button');
					btn.type = 'button';
					btn.id = base + '-button';
					btn.className = sel.className + ' flex cursor-pointer items-center justify-between gap-2 text-left';
					btn.setAttribute('aria-haspopup', 'listbox');
					btn.setAttribute('aria-expanded', 'false');
					var label = document.createElement('span');
					label.className = 'truncate';
					btn.appendChild(label);
					btn.insertAdjacentHTML('beforeend', '<svg class="size-4 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>');
					var pop = document.createElement('div');
					pop.id = base + '-list';
					pop.setAttribute('popover', '');
					pop.setAttribute('role', 'listbox');
					pop.className = 'fixed m-0 max-h-72 overflow-y-auto overscroll-contain rounded-xl border border-slate-200 bg-surface p-1 shadow-lg shadow-black/10';
					btn.setAttribute('popovertarget', pop.id);
					var items = [];
					function addItem(opt, indent) {
						var item = document.createElement('button');
						item.type = 'button';
						item.tabIndex = -1;
						item.setAttribute('role', 'option');
						item.dataset.value = opt.value;
						item.className = 'group/option flex w-full cursor-pointer items-center justify-between gap-2 rounded-md py-2 pr-2.5 text-left text-sm text-slate-700 transition hover:bg-slate-100 focus:bg-slate-100 focus:outline-none aria-selected:font-medium aria-selected:text-brand ' + (indent ? 'pl-5' : 'pl-2.5');
						var text = document.createElement('span');
						text.className = 'truncate';
						text.textContent = opt.textContent;
						item.appendChild(text);
						item.insertAdjacentHTML('beforeend', '<svg class="hidden size-4 shrink-0 group-aria-selected/option:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>');
						item.addEventListener('click', function () {
							if (sel.value !== opt.value) {
								sel.value = opt.value;
								sel.dispatchEvent(new Event('change', { bubbles: true }));
							}
							sync();
							pop.hidePopover();
						});
						pop.appendChild(item);
						items.push(item);
					}
					Array.prototype.forEach.call(sel.children, function (child) {
						if (child.tagName === 'OPTGROUP') {
							var head = document.createElement('div');
							head.className = 'px-2.5 pt-2 pb-1 text-xs font-semibold tracking-wide text-slate-500 uppercase';
							head.textContent = child.label;
							pop.appendChild(head);
							Array.prototype.forEach.call(child.children, function (o) { addItem(o, true); });
						} else {
							addItem(child, false);
						}
					});
					function sync() {
						var current = sel.options[sel.selectedIndex];
						label.textContent = current ? current.textContent : '';
						items.forEach(function (item) { item.setAttribute('aria-selected', current && item.dataset.value === current.value ? 'true' : 'false'); });
					}
					sel._sync = sync;
					pop.addEventListener('toggle', function (e) {
						btn.setAttribute('aria-expanded', e.newState === 'open');
						if (e.newState !== 'open') return;
						sync();
						var r = btn.getBoundingClientRect();
						var below = window.innerHeight - r.bottom - 12, above = r.top - 12;
						var fits = pop.scrollHeight + 2 <= below || below >= above;
						pop.style.width = r.width + 'px';
						pop.style.left = Math.max(8, Math.min(r.left, window.innerWidth - r.width - 8)) + 'px';
						pop.style.maxHeight = Math.min(288, fits ? below : above) + 'px';
						if (fits) { pop.style.top = r.bottom + 4 + 'px'; pop.style.bottom = 'auto'; }
						else { pop.style.top = 'auto'; pop.style.bottom = window.innerHeight - r.top + 4 + 'px'; }
						(items.filter(function (i) { return i.getAttribute('aria-selected') === 'true'; })[0] || items[0]).focus();
					});
					pop.addEventListener('keydown', function (e) {
						var i = items.indexOf(document.activeElement);
						var to = { ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: items.length - 1 }[e.key];
						if (to === undefined) return;
						e.preventDefault();
						items[Math.max(0, Math.min(items.length - 1, to))].focus();
					});
					btn.addEventListener('keydown', function (e) {
						if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); pop.showPopover(); }
					});
					var lab = sel.id && document.querySelector('label[for="' + sel.id + '"]');
					if (lab) lab.setAttribute('for', btn.id);
					sel.className = 'sr-only';
					sel.tabIndex = -1;
					sel.setAttribute('aria-hidden', 'true');
					sel.insertAdjacentElement('afterend', btn);
					btn.insertAdjacentElement('afterend', pop);
					sync();
				}
				htmx.onLoad(function (root) { root.querySelectorAll('select[data-select]').forEach(enhanceSelect); });
				// a form that is reset or filled by a script changes its selects without an event
				function syncSelects(root) { root.querySelectorAll('select[data-select]').forEach(function (el) { if (el._sync) el._sync(); }); }
				document.addEventListener('reset', function (e) { setTimeout(function () { syncSelects(e.target); }); });
				// Escape closes the menu of feeds of a list and gives the focus back to its button
				document.addEventListener('keydown', function (e) {
					if (e.key !== 'Escape') return;
					var menu = document.querySelector('details[open][data-menu]');
					if (!menu) return;
					menu.removeAttribute('open');
					menu.querySelector('summary').focus();
				});
				// "/" or Ctrl/Cmd+K opens the search, unless something is being typed in
				document.addEventListener('keydown', function (e) {
					var el = document.activeElement;
					if (el && (/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) || el.isContentEditable)) return;
					if (document.querySelector('dialog[open]')) return;
					if (!((e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'))) return;
					e.preventDefault();
					if (location.pathname === '/search') document.getElementById('search-input').focus();
					else htmx.ajax('GET', '/search', { target: '#content', swap: 'innerHTML' }).then(function () { history.pushState({}, '', '/search'); markActive(); });
				});
				// swipe in from the left edge to open the sidebar on small screens, swipe left to close it
				(function () {
					var start = null;
					document.addEventListener('touchstart', function (e) {
						var t = e.touches[0];
						var open = document.getElementById('sidebar').hasAttribute('data-open');
						start = e.touches.length === 1 && !document.getElementById('article-panel').open && (open || t.clientX < 28) ? { x: t.clientX, y: t.clientY, open: open } : null;
					}, { passive: true });
					document.addEventListener('touchend', function (e) {
						if (!start || window.innerWidth >= 768) return;
						var t = e.changedTouches[0];
						var dx = t.clientX - start.x, dy = t.clientY - start.y;
						if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
							if (!start.open && dx > 0) toggleSidebar(true);
							else if (start.open && dx < 0) toggleSidebar(false);
						}
						start = null;
					}, { passive: true });
				})();
				// highlight the sidebar link of the page that is showing and close the mobile sidebar after navigating
				// a link is current for its own page, and the links of a section for the pages inside it: Settings for its tabs
				function isCurrent(path, exact) {
					return path === location.pathname || (!exact && path !== '/' && location.pathname.startsWith(path + '/'));
				}
				function markActive() {
					document.querySelectorAll('[data-nav]').forEach(function (a) {
						if (isCurrent(new URL(a.href).pathname, a.hasAttribute('data-nav-exact'))) a.setAttribute('aria-current', 'page');
						else a.removeAttribute('aria-current');
					});
				}
				markActive();
				document.addEventListener('htmx:pushedIntoHistory', function () { markActive(); toggleSidebar(false); });
				document.addEventListener('htmx:oobAfterSwap', markActive);
				window.addEventListener('popstate', markActive);
				// open feed menus to the right of the sidebar, level with their button
				document.addEventListener('toggle', function (e) {
					if (!e.target.matches('[data-menu]') || e.newState !== 'open') return;
					var menu = e.target;
					var btn = document.querySelector('[popovertarget="' + menu.id + '"]');
					var side = document.getElementById('sidebar').getBoundingClientRect();
					var r = btn.getBoundingClientRect();
					var left = Math.min(side.right + 8, window.innerWidth - menu.offsetWidth - 8);
					var top = Math.min(r.top, window.innerHeight - menu.offsetHeight - 8);
					// the menus of the table are below their button, their right edge at its right edge
					if (menu.hasAttribute('data-menu-below')) {
						left = Math.max(8, Math.min(r.right - menu.offsetWidth, window.innerWidth - menu.offsetWidth - 8));
						top = r.bottom + 4;
						if (top + menu.offsetHeight > window.innerHeight - 8) top = r.top - menu.offsetHeight - 4;
					}
					menu.style.left = left + 'px';
					menu.style.top = Math.max(8, top) + 'px';
				}, true);
				// menu items with data-open-modal open that dialog, filled with the data-name of the item
				document.addEventListener('click', function (e) {
					var item = e.target.closest('[data-open-modal]');
					if (!item) return;
					var modal = document.getElementById(item.dataset.openModal);
					// start from an empty form, the dialogs are reused
					modal.querySelectorAll('form').forEach(function (f) { f.reset(); });
					// data-folder preselects the folder of the feed to add, no data-folder means no folder
					modal.querySelectorAll('select[name=folder]').forEach(function (el) { el.value = item.dataset.folder || ''; if (el._sync) el._sync(); });
					modal.querySelectorAll('[data-fill-text]').forEach(function (el) { el.textContent = item.dataset.name; });
					modal.querySelectorAll('[data-fill-id]').forEach(function (el) { el.value = item.dataset.id; });
					modal.querySelectorAll('input[name=name][type=text]').forEach(function (el) { if (item.dataset.name) el.value = item.dataset.name; });
					// data-settings holds the values of the fields of the form, by name
					if (item.dataset.settings) {
						var values = JSON.parse(item.dataset.settings);
						modal.querySelectorAll('form [name]').forEach(function (el) {
							if (!(el.name in values)) return;
							if (el.type === 'checkbox') el.checked = !!values[el.name];
							else el.value = values[el.name];
						});
					}
					var menu = item.closest('[data-menu]');
					if (menu) menu.hidePopover();
					modal.showModal();
				});
				// close the menu once an item is picked
				document.addEventListener('click', function (e) {
					var item = e.target.closest('[data-menu] [role=menuitem]');
					if (item) item.closest('[data-menu]').hidePopover();
				});
			</script>
		</body>
	</html>
}
