package layouts

import "github.com/cksidharthan/lavender/pkg/ui/components"

// Auth is the shared shell for the login / register style pages.
templ Auth(title string) {
	<!DOCTYPE html>
	<html lang="en" style="background:#fff">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ title } · Lavender</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
			<link rel="manifest" href="/static/manifest.webmanifest"/>
			<meta name="theme-color" content="#ffffff"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="Lavender"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class="min-h-dvh bg-linear-to-b from-indigo-50 via-white to-white font-sans text-slate-950 antialiased">
			<main class="flex min-h-dvh flex-col items-center justify-center gap-6 px-4 pt-[max(2rem,env(safe-area-inset-top))] pb-[max(2rem,env(safe-area-inset-bottom))]">
				@components.Logo()
				<div class="w-full max-w-100 rounded-2xl border border-slate-200/70 bg-white p-6 shadow-xl shadow-indigo-950/5 sm:p-8">
					{ children... }
				</div>
			</main>
			@components.ToastContainer()
		</body>
	</html>
}
